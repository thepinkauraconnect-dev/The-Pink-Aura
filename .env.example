WHATSAPP_CALLMEBOT_API_KEY=1234567

# Optional: Custom WhatsApp Webhook (e.g. Zapier / Make / UltraMsg)
WHATSAPP_WEBHOOK_URL=https://api.example.com/whatsapp-webhook

