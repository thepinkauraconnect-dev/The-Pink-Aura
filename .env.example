FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@the-pink-aura.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Resend API Key for Email Notifications
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Target Email Address for New Consultation Notifications
PINK_AURA_NOTIFICATION_EMAIL=thepinkaura.connect@gmail.com

# ==========================================
# WHATSAPP AUTOMATED MOBILE ALERTS (FREE)
